{
  "name": "burrow",
  "version": "1.7.0",
  "description": "Chrome extension that scores tabs, archives clutter, and keeps everything searchable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test && npm run build",
    "icons": "node scripts/icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "license": "node scripts/license.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matutozi/Burrow.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Matutozi/Burrow/issues"
  },
  "homepage": "https://github.com/Matutozi/Burrow#readme",
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
